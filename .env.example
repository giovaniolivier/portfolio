# Variables lues au build (`npm run build`) : sur Render, les définir dans
# Environment, puis relancer un déploiement pour qu'elles soient prises en compte.

# VITE_SITE_URL : URL publique du site, sans slash final
# (ex. https://mon-portfolio.onrender.com). Active l'URL canonique, les balises
# og:url / og:image absolues (aperçus LinkedIn, WhatsApp…) et sitemap.xml.
VITE_SITE_URL=""

# VITE_CONTACT_ENDPOINT : URL d'envoi du formulaire de contact
# (ex. https://formspree.io/f/xxxxxxx). Vide → le formulaire ouvre la messagerie
# du visiteur (mailto:). Également lue par le serveur pour l'autoriser dans la CSP.
VITE_CONTACT_ENDPOINT=""
